{
  "Version": {
    "Major": 1,
    "Minor": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "GymTrackApi",
    "Key": "THIS IS SOME SECRET JWT KEY WHICH WILL NOT BE STORED HERE WHEN DEPLOYED - USE SECRET MANAGER IN CSP",
    "ExpirationInMinutes": 60,
    "ValidateAudience": true
  },
  "RefreshToken": {
    "ExpiryTimeInMinutes": 2880
  },
  "EmailSender": {
    "ApiKey": "YOUR API KEY - STORE SECURELY INSTEAD OF HERE!",
    "Sender": {
      "Email": "YOUR-EMAIL@YOUR-DOMAIN.COM",
      "Name": "Gym Track"
    }
  },
  "EmailConfirmation": {
    "ExpiryTimeInMinutes": 4320
  },
  "PasswordReset": {
    "ExpiryTimeInMinutes": 1440
  },
  "Frontend": {
    "BaseUrl": "https://localhost:7173",
    "ConfirmEmailRoute": "confirm-email",
    "PasswordResetRoute": "reset-password"
  },
  "OpenApi": {
    "Enabled": false,
    "Url": "https://localhost:7050"
  }
}
