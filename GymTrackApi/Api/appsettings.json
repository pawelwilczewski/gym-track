{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "GymTrackApi",
    "Key": "THIS IS SOME SECRET JWT KEY WHICH WILL NOT BE STORED HERE WHEN DEPLOYED - USE SECRET MANAGER IN CSP",
    "ExpirationInMinutes": 60
  },
  "SendGrid": {
    "ApiKey": "YOUR API KEY - STORE SECURELY INSTEAD OF HERE!",
    "Sender": {
      "Email": "YOUR-EMAIL@YOUR-DOMAIN.COM",
      "Name": "Gym Track"
    }
  },
  "EmailConfirmation": {
    "ExpiryTimeInMinutes": 1440
  },
  "Frontend": {
    "BaseUrl": "https://localhost:7173/",
    "ConfirmEmailRoute": "confirm-email"
  }
}
